      ],
      "biography": [
        {
          "type": "p",
          "runs": [
            {
              "text": "Melissa grew up on a cattle station in far Western Qld and has an honours degree in Rural Science (UNE Armidale). Her work history includes time as a rural analyst with National Australia Bank, electorate officer for a Federal MP, financial analysis for an agricultural consultant, and farming irrigated peanuts in the Northern Territory.\u00a0"
            },
            {
              "text": "After returning to Qld, Melissa retrained as a bookkeeper and BAS Agent, and now applies her strengths in research, detail and analysis to this industry. She enjoys helping people find solutions to challenges and using technology to empower their business."
            }
          ]
        }
